{
  "name": "open-auth-kit",
  "version": "0.2.0",
  "private": false,
  "description": "A polished, rebrandable authorization UI with a safe local demo mode and provider-agnostic integration hooks.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host localhost",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "pnpm audit --prod",
    "audit:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "framer-motion": "^12.23.22",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "vite": "^7.1.9",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1"
}
