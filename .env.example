# Open Auth Kit: safe local demo defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Public branding. These VITE_* values are intentionally visible in the browser.
VITE_BRAND_NAME=Open Auth Kit
VITE_BRAND_LOGO=/logo.svg
VITE_BRAND_TAGLINE=One account. Everywhere you build.
VITE_BRAND_ACCENT=#667161

# demo = local-only fake flow; redirect = send users to your real server-side auth provider.
VITE_AUTH_MODE=demo
VITE_AUTH_PROVIDERS=google,github,discord,apple

# Demo-only placeholders. Never use real credentials here.
VITE_DEMO_EMAIL=demo@example.test
VITE_DEMO_PASSWORD=demo-pass-1234

# Required only when VITE_AUTH_MODE=redirect. Use HTTPS in production.
# VITE_AUTH_LOGIN_URL=https://auth.example.com/login
# VITE_AUTH_SIGNUP_URL=https://auth.example.com/signup
# VITE_AUTH_PROVIDER_URL_GOOGLE=https://auth.example.com/oauth/google
# VITE_AUTH_PROVIDER_URL_GITHUB=https://auth.example.com/oauth/github
# VITE_AUTH_PROVIDER_URL_DISCORD=https://auth.example.com/oauth/discord
# VITE_AUTH_PROVIDER_URL_APPLE=https://auth.example.com/oauth/apple
# VITE_PRIVACY_URL=https://example.com/privacy
# VITE_TERMS_URL=https://example.com/terms

# Server-only storage selection. The demo defaults to memory and does not persist users.
DATABASE_PROVIDER=memory
DATABASE_TABLE=auth_users
# DATABASE_NAMESPACE=your-namespace

# Keep real provider keys, database URLs, service-role keys, and OAuth client secrets
# outside the browser and outside Git. Put them in your deployment secret manager.
